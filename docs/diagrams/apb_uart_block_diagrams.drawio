le="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-done" target="p5-odone"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-e13" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.8000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-bc" target="p5-obg"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. uart_rx"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6-t" value="uart_rx: lọc 2/3, phát hiện start, FSM IDLE → START → DATA → [PARITY] → STOP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="40" as="geometry"/></mxCell><mxCell id="p6-in" value="rx_s (sau sync_2ff)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="140" height="40" as="geometry"/></mxCell><mxCell id="p6-ff" value="rx_1_q → rx_2_q" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="240" y="100" width="200" height="60" as="geometry"/></mxCell><mxCell id="p6-vote" value="majority vote&lt;br&gt;rx_v = maj(rx_s, rx_1, rx_2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="220" height="60" as="geometry"/></mxCell><mxCell id="p6-edge" value="rx_v_q (FF), settle_q[3:0]&lt;br&gt;start = IDLE &amp; ~rx_dis &amp; settle&lt;br&gt;&amp; rx_v_q &amp; ~rx_v" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="220" width="220" height="80" as="geometry"/></mxCell><mxCell id="p6-fsm" value="FSM  state_q[2:0]&lt;br&gt;&lt;br&gt;IDLE, START, DATA,&lt;br&gt;PARITY, STOP&lt;br&gt;&lt;br&gt;rx_dis = 1 → IDLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="820" y="200" width="260" height="200" as="geometry"/></mxCell><mxCell id="p6-cnt" value="tick_cnt_q[3:0]&lt;br&gt;sample = tick &amp; (cnt == 7)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="520" y="400" width="220" height="70" as="geometry"/></mxCell><mxCell id="p6-data" value="data_q[7:0], bit_idx_q[2:0]&lt;br&gt;data_q[idx] = rx_v" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1170" y="100" width="240" height="70" as="geometry"/></mxCell><mxCell id="p6-par" value="par_q, perr_q&lt;br&gt;perr = par ^ rx_v ^ ~parity_type" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1170" y="200" width="240" height="70" as="geometry"/></mxCell><mxCell id="p6-stop" value="stop_idx_q, ferr_q&lt;br&gt;ferr |= ~rx_v (mỗi stop)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1170" y="300" width="240" height="70" as="geometry"/></mxCell><mxCell id="p6-vb" value="busy_q, valid_q&lt;br&gt;rx_valid: xung 1 chu kỳ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1170" y="400" width="240" height="70" as="geometry"/></mxCell><mxCell id="p6-cfgin" value="data_bits, stop_bits&lt;br&gt;parity_en, parity_type&lt;br&gt;rx_dis, tick, srst" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="260" height="90" as="geometry"/></mxCell><mxCell id="p6-out" value="Ra uart_regs&lt;br&gt;rx_valid, rx_data[7:0]&lt;br&gt;rx_perr, rx_ferr, rx_busy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="540" width="260" height="90" as="geometry"/></mxCell><mxCell id="p6-bg" value="baud_clr = srst | start&lt;br&gt;baud_en = state ≠ IDLE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="820" y="540" width="260" height="60" as="geometry"/></mxCell><mxCell id="p6-obg" value="baud_en, baud_clr → baud_gen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="680" width="260" height="40" as="geometry"/></mxCell><mxCell id="p6-nt" value="baud_gen bị xóa ở cạnh start nên tick thứ 8 rơi giữa start bit; mẫu sau cách 16 tick.&lt;br&gt;Kiểm tra lại start ở tick 8: rx_v = 1 là glitch, về IDLE. Giữa stop cuối: rx_valid = 1 và về IDLE, kể cả khi frame lỗi." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="760" height="80" as="geometry"/></mxCell><mxCell id="p6-e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6-in" target="p6-ff"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0000;exitY=0.50