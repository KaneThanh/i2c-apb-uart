ell><mxCell id="p4-apb" value="APB vào&lt;br&gt;psel, penable, pwrite&lt;br&gt;paddr[11:0]&lt;br&gt;pstrb[3:0]&lt;br&gt;pwdata[31:0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="200" height="170" as="geometry"/></mxCell><mxCell id="p4-dec" value="Giải mã địa chỉ&lt;br&gt;idx = paddr[4:2]&lt;br&gt;addr_ok, sel_TXDATA … sel_IER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="260" height="100" as="geometry"/></mxCell><mxCell id="p4-err" value="Kiểm tra pslverr (tổ hợp)&lt;br&gt;E1 địa chỉ sai / 0x1C&lt;br&gt;E2 ghi RXDATA, STAT&lt;br&gt;E3 ghi TXDATA/START khi TX bận&lt;br&gt;E4 ghi CFG/BAUD khi busy&lt;br&gt;E5 BAUD div_int = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="320" y="240" width="260" height="130" as="geometry"/></mxCell><mxCell id="p4-wr" value="Xung ghi&lt;br&gt;wr = psel &amp; penable &amp; pwrite&lt;br&gt;&amp; ~pslverr" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="680" y="250" width="230" height="70" as="geometry"/></mxCell><mxCell id="p4-txd" value="TXDATA [7:0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="200" height="45" as="geometry"/></mxCell><mxCell id="p4-cfg" value="CFG [6:0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="200" height="45" as="geometry"/></mxCell><mxCell id="p4-baud" value="BAUD [15:0]  (reset 0x900D)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1000" y="210" width="200" height="45" as="geometry"/></mxCell><mxCell id="p4-ier" value="IER [2:0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1000" y="270" width="200" height="45" as="geometry"/></mxCell><mxCell id="p4-ctrl" value="CTRL (không lưu)&lt;br&gt;START [0], SOFT_RST [8]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="200" height="60" as="geometry"/></mxCell><mxCell id="p4-rxin" value="Từ uart_rx&lt;br&gt;rx_valid, rx_data[7:0]&lt;br&gt;rx_perr, rx_ferr, rx_busy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="200" height="100" as="geometry"/></mxCell><mxCell id="p4-rxf" value="Cờ RX (FF)&lt;br&gt;rxdata_q[7:0], rx_done_q&lt;br&gt;perr_q, ferr_q, ovr_q&lt;br&gt;rx_valid khi rx_done=1 → ovr=1, giữ byte cũ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="470" width="280" height="110" as="geometry"/></mxCell><mxCell id="p4-stat" value="STAT = {ovr, ferr, rx_dis, tx_dis,&lt;br&gt;rx_busy, perr, rx_done, tx_done}&lt;br&gt;(tx_done từ uart_tx)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="680" y="460" width="300" height="70" as="geometry"/></mxCell><mxCell id="p4-mux" value="prdata mux (tổ hợp)&lt;br&gt;chỉ khi đọc hợp lệ, còn lại 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="680" y="620" width="300" height="60" as="geometry"/></mxCell><mxCell id="p4-irq" value="irq_q (FF)&lt;br&gt;(IER[0]&amp;tx_done) | (IER[1]&amp;rx_done) | (IER[2]&amp;lỗi)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1260" y="470" width="300" height="60" as="geometry"/></mxCell><mxCell id="p4-rts" value="rts_n_q (FF)&lt;br&gt;CFG[6] | rx_done | srst_q | soft_rst_wr" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1260" y="560" width="300" height="60" as="geometry"/></mxCell><mxCell id="p4-srst" value="srst_q (FF)&lt;br&gt;xóa thanh ghi + reset TX/RX" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1260" y="340" width="300" height="60" as="geometry"/></mxCell><mxCell id="p4-start" value="tx_start = wr &amp; START&lt;br&gt;&amp; ~SOFT_RST &amp; ~CFG[5]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1260" y="250" width="300" height="60" as="geometry"/></mxCell><mxCell id="p4-o_cfg" value="Tới uart_tx / uart_rx / baud_gen&lt;br&gt;tx_data, data_bits, stop_bits,&lt;br&gt;parity_en, parity_type, rx_dis,&lt;br&gt;div_int, div_frac" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="120" width="300" height="80" as="geometry"/></mxCell><mxCell id="p4-o_bus" value="prdata[31:0], pslverr, pready = 1&lt;br&gt;irq, rts_n, srst" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="640" width="300" height="50" as="geometry"/></mxCell><mxCell id="p4-nt" value="Đọc CTRL trả 0. Đọc RXDATA khi slot rỗng trả byte nhận gần nhất (0 sau reset).&lt;br&gt;rx_valid cùng chu kỳ với lệnh đọc RXDATA: byte cũ ra prdata, slot nhận byte mới.&lt;br&gt;srst_q và soft_rst_wr đưa TXDATA, RXDATA, CFG, IER về 0, BAUD về 0x900D, xóa cờ RX." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="740" width="1100" height="80" as="geometry"/></mxCell><mxCell id="p4-e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#3333