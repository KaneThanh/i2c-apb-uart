ick_cnt_q[3:0]&lt;br&gt;bit_end = tick &amp; (cnt == 15)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="220" height="80" as="geometry"/></mxCell><mxCell id="p5-idx" value="bit_idx_q[2:0]&lt;br&gt;last_idx = data_bits + 4  (N−1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="90" width="240" height="80" as="geometry"/></mxCell><mxCell id="p5-mux" value="data[next_idx]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="210" width="240" height="60" as="geometry"/></mxCell><mxCell id="p5-par" value="par_q: XOR tích lũy data&lt;br&gt;parity_bit = par_q ^ ~parity_type" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="310" width="240" height="80" as="geometry"/></mxCell><mxCell id="p5-stp" value="stop_idx_q&lt;br&gt;(2 stop bit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="430" width="240" height="60" as="geometry"/></mxCell><mxCell id="p5-txq" value="tx_q (FF)&lt;br&gt;reset = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1060" y="200" width="180" height="70" as="geometry"/></mxCell><mxCell id="p5-done" value="done_q (FF)&lt;br&gt;reset = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1060" y="320" width="180" height="60" as="geometry"/></mxCell><mxCell id="p5-bc" value="baud_clr = WAIT_CTS &amp; ~cts_n_s&lt;br&gt;baud_en = state ≥ START" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="440" width="300" height="70" as="geometry"/></mxCell><mxCell id="p5-otx" 