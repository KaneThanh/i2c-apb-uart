="1200" height="40" as="geometry"/></mxCell><mxCell id="p7-in" value="BAUD&lt;br&gt;div_int[11:0]&lt;br&gt;div_frac[3:0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="200" height="90" as="geometry"/></mxCell><mxCell id="p7-acc" value="acc_q[3:0] (FF)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="230" width="200" height="60" as="geometry"/></mxCell><mxCell id="p7-add" value="acc_sum = acc_q + div_frac&lt;br&gt;carry = acc_sum[4]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="240" height="80" as="geometry"/></mxCell><mxCell id="p7-tgt" value="target = div_int + carry − 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="260" height="80" as="geometry"/></mxCell><mxCell id="p7-cnt" value="cnt_q[11:0] (FF)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="240" width="200" height="60" as="geometry"/></mxCell><mxCell id="p7-cmp" value="tick = en &amp;&lt;br&gt;(cnt_q == target)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="160" width="200" height="80" as="geometry"/></mxCell><mxCell id="p7-ctl" value="clr, en&lt;br&gt;(từ uart_tx / uart_rx)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="200" height="70" as="geometry"/></mxCell><mxCell id="p7-otick" value="tick" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="140" height="40" as="geometry"/></mxCell><mxCell id="p7-nt" value="Tick thứ k sau clr cách k·div_int + ⌊k·div_frac / 16⌋ chu kỳ pclk: khoảng cách giữa hai tick là div_int hoặc div_int + 1.&lt;br&gt;Ví dụ BAUD = 0x900D (div_int = 13, div_frac = 9) ở 25 MHz: 13,5625 chu kỳ/tick ≈ 115 200 baud × 16.&lt;br&gt;div_int phải ≥ 1 (ghi div_int = 0 bị E5). Hai instance độc lập cho TX và RX, cùng BAUD." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="1150" height="100" as="geometry"/></mxCell><mxCell id="p7-e0" value="div_frac" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0000;exitY=0.2222;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3750;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-in" target="p7-add"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-e1" value="div_int" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-in" target="p7-tgt"><mxGeometry x="0.4" relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="80"/><mxPoint x="770" y="80"/></Array></mxGeometry></mxCell><mxCell id="p7-e2" value="acc_q" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.4167;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-acc" target="p7-add"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-e3" value="carry" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-add" target="p7-tgt"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-e4" value="acc_sum[3:0] (khi tick)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.0000;exitY=0.7500;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-add" target="p7-acc"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="160"/><mxPoint x="290" y="260"/></Array></mxGeometry></mxCell><mxCell id="p7-e5" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3125;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-tgt" target="p7-cmp"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="140"/><mxPoint x="930" y="185"/></Array></mxGeometry></mxCell><mxCell id="p7-e6" value="cnt_q" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.6875;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-cnt" target="p7-cmp"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="270"/><mxPoint x="930" y="215"/></Array></mxGeometry></mxCell><mxCell id="p7-e7" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.4286;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-cmp" target="p7-otick"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-e8" value="tick → cnt = 0, else +1" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.2000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-cmp" target="p7-cnt"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="330"/><mxPoint x="740" y="330"/></Array></mxGeometry></mxCell><mxCell id="p7-e9" value="clr → 0" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.8333;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-ctl" target="p7-cnt"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="365"/><mxPoint x="600" y="290"/></Array></mxGeometry></mxCell><mxCell id="p7-e10" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0000;exitY=0.2857;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.8333;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-ctl" target="p7-acc"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="350"/><mxPoint x="280" y="280"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="8. spi2apb"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8-t" value="spi2apb: SPI mode 0 slave → APB4 master (khung 56 bit)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="40" as="geometry"/></mxCell><mxCell id="p8-pins" value="spi_cs_n&lt;br&gt;spi_sclk&lt;br&gt;spi_mosi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="170" height="130" as="geometry"/></mxCell><mxCell id="p8-sync" value="sync_2ff × 3&lt;br&gt;cs_n_s, sclk_s, mosi_s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="260" y="100" width="200" height="130" as="geometry"/></mxCell><mxCell id="p8-edge" value="sclk_q (FF)&lt;br&gt;rise / fall khi active (cs_n_s=0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="540" y="100" width="240" height="80" as="geometry"/></mxCell><mxCell id="p8-cnt" value="cnt_q[5:0]&lt;br&gt;số sườn lên, bão hòa ở 63" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="540" y="240" width="240" height="70" as="geometry"/></mxCell><mxCell id="p8-sr" value="sr_q[31:0]&lt;br&gt;dịch MOSI vào / dịch prdata ra&lt;br&gt;nạp prdata khi đọc xong" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="260" height="90" as="geometry"/></mxCell><mxCell id="p8-cmd" value="Chốt cmd ở sườn lên thứ 8&lt;br&gt;rw_q, cerr_q = |cmd[6:4]&lt;br&gt;addr_q = cmd[3:0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="240" width="260" height="80" as="geometry"/></mxCell><mxCell id="p8-go" value="rd_go: sườn 8, lệnh đọc, cmd hợp lệ&lt;br&gt;wr_go: sườn 48, lệnh ghi, cerr = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="860" y="380" width="260" height="80" as="geometry"/></mxCell><mxCell id="p8-apb" value="APB master (FF)&lt;br&gt;psel_q → penable_q → xong&lt;br&gt;paddr = {6'b0, addr_q, 2'b00}&lt;br&gt;pstrb = {4{rw_q}}, pwdata = sr_q" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1200" y="360" width="300" height="140" as="geometry"/></mxCell><mxCell id="p8-miso" value="miso_q (đổi ở sườn xuống)&lt;br&gt;B2–B5: sr_q[31] (lệnh đọc)&lt;br&gt;bit 54: cerr_q, bit 55: perr_q" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="540" y="520" width="300" height="90" as="geometry"/></mxCell><mxCell id="p8-perr" value="perr_q ← pslverr khi access" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="880" y="560" width="240" height="50" as="geometry"/></mxCell><mxCell id="p8-omiso" value="spi_miso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="545" width="170" height="40" as="geometry"/></mxCell><mxCell id="p8-oapb" value="APB4 tới apb_uart_core&lt;br&gt;(prdata, pready, pslverr về)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="680" width="300" height="60" as="geometry"/></mxCell><mxCell id="p8-nt" value="Khung: B0 cmd [7] rw, [6:4] = 000, [3:0] chỉ số thanh ghi; B1 turnaround; B2–B5 dữ liệu (MSB trước); B6 trạng thái [1] cmd_err, [0] pslverr.&lt;br&gt;Đọc chạy sau sườn lên thứ 8, ghi sau sườn lên thứ 48. SCLK được lấy mẫu trong miền pclk, không dùng làm clock (f_SCLK ≤ f_pclk / 10).&lt;br&gt;spi_miso = miso_q &amp; ~spi_cs_n: về 0 ngay khi CS lên. Giao dịch APB đã bắt đầu vẫn chạy xong dù CS lên." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="1100" height="110" as="geometry"/></mxCell><mxCell id="p8-e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p8-pins" target="p8-sync"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8-e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0000;exitY=0.3077;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p8-sync" target="p8-edge"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8-e2" value="rise" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p8-edge" target="p8-cnt"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8-e3" value="rise / fall" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.4444;entryDx=0;entryDy=0;" edge="1" parent="1" source="p8-edge" target="p8-sr"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8-e4" value="mosi_s" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.7000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p8-sync" target="p8-sr"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="80"/><mxPoint x="990" y="80"/></Array></mxGeometry></mxCell><mxCell id="p8-e5" value="cnt = 7" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p8-cnt" target="p8-cmd"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="820.0" y="275"/><mxPoint x="820.0" y="280"/></Array></mxGeometry></mxCell><mxCell id="p8-e6" value="sr_q[6:0]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColo