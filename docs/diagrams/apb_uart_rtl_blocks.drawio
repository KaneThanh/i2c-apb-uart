        </mxCell>
        <mxCell id="q6-cnt" value="tick_cnt_q (4 bit FF)&lt;br&gt;sample = tick &amp; (tick_cnt_q == 7)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="580" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q6-data" value="data_q (8 bit FF), bit_idx_q (3 bit)&lt;br&gt;data_q[bit_idx_q] ← rx_v" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="100" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q6-par" value="par_q, perr_q (FF)&lt;br&gt;perr = par_q ^ rx_v ^ ~parity_type" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
