          <mxGeometry x="620" y="300" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="q7-cmp" value="tick = en &amp;&lt;br&gt;({1&#39;b0, cnt_q} == target)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="200" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q7-otick" value="tick" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="225" width="110" height="20" as="geometry" />
        </mxCell>
        <mxCell id="q7-nt" value="clr = 1: cnt_q = 0, acc_q = 0.  en = 1: tick → cnt_q = 0 và acc_q = acc_sum[3:0]; không tick → cnt_q + 1.&lt;br&gt;Tick thứ k sau clr cách k·div_int + ⌊k·div_frac / 16⌋ chu kỳ pclk. Ví dụ BAUD = 0x900D (div_int = 13, div_frac = 9): 13,5625 chu kỳ/tick.&lt;br&gt;Nối trong core: TX: en = tx_baud_en, clr = tx_baud_clr | srst.  RX: en = rx_baud_en, clr = rx_baud_clr." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="20" y="470" width="1300" height="80" as="geometry" />
