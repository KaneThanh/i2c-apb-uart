          <mxGeometry x="260" y="260" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="q7-tgt" value="target = div_int + carry − 1&lt;br&gt;(13 bit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="160" width="240" height="60" as="geometry" />
