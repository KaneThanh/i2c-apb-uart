        <mxCell id="q6-stop" value="stop_idx_q, ferr_q (FF)&lt;br&gt;ferr |= ~rx_v ở mỗi stop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
