        </mxCell>
        <mxCell id="q7-e2" value="acc_sum[3:0] (4 bit)" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.7391;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.7391;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="q7-add" target="q7-acc">
