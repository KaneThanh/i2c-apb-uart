          <mxGeometry x="20" y="690" width="110" height="20" as="geometry" />
        </mxCell>
        <mxCell id="q6-ff" value="rx_1_q → rx_2_q (FF)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="q6-vote" value="rx_v = majority(rx_s,&lt;br&gt;rx_1_q, rx_2_q)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q6-st" value="rx_v_q (FF), settle_q (4 bit FF)&lt;br&gt;start = IDLE &amp; ~rx_dis&lt;br&gt;&amp; settle_q[3] &amp; rx_v_q &amp; ~rx_v" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="210" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="q6-fsm" value="FSM  state_q (3 bit)&lt;br&gt;&lt;br&gt;IDLE=0, START=1, DATA=2,&lt;br&gt;PARITY=3, STOP=4&lt;br&gt;&lt;br&gt;rx_dis = 1 → IDLE&lt;br&gt;srst → IDLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="200" width="260" height="240" as="geometry" />
        </mxCell>
        <mxCell id="q6-last" value="last_idx = data_bits + 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=10;" vertex="1" parent="1">
