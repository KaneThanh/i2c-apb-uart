        <mxCell id="q9-sr" value="sr_q (32 bit FF)&lt;br&gt;ghi/cmd: dịch mosi_s vào ở rise&lt;br&gt;đọc: nạp prdata, dịch ra ở fall" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
