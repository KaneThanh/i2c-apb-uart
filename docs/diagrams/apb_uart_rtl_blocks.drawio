          <mxGeometry x="0.0000" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q7-e1" value="acc_q (4 bit)" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.2609;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.2609;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="q7-acc" target="q7-add">
