        </mxCell>
        <mxCell id="q5-fsm" value="FSM  state_q (3 bit)&lt;br&gt;fsm_encoding = &quot;none&quot;&lt;br&gt;&lt;br&gt;IDLE=0, WAIT_CTS=1, START=2,&lt;br&gt;DATA=3, PARITY=4, STOP=5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="260" height="220" as="geometry" />
        </mxCell>
        <mxCell id="q5-last" value="last_idx = data_bits + 4&lt;br&gt;(= N − 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="340" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="q5-cmp" value="last = (bit_idx_q == last_idx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="340" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="q5-cnt" value="tick_cnt_q (4 bit FF)&lt;br&gt;bit_end = tick &amp; (tick_cnt_q == 15)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
