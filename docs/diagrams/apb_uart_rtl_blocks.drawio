        <mxCell id="q9-sync" value="sync_2ff × 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontStyle=1;spacingTop=2;" vertex="1" parent="1">
