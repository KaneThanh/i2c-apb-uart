        </mxCell>
        <mxCell id="q7-add" value="acc_sum = acc_q + div_frac (5 bit)&lt;br&gt;carry = acc_sum[4]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="100" width="230" height="60" as="geometry" />
