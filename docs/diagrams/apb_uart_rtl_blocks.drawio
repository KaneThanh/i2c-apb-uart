        <mxCell id="1" parent="0" />
        <mxCell id="q7-t" value="7. baud_gen: bộ chia nguyên–phân số, tick ×16 baud (1 instance cho TX, 1 cho RX)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1300" height="36" as="geometry" />
        </mxCell>
        <mxCell id="q7-idiv_frac" value="div_frac" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="q7-idiv_int" value="div_int" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="190" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="q7-iclr" value="clr" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="100" height="20" as="geometry" />
